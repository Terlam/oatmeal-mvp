rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Event cover images (host can upload, anyone can read)
    match /events/{eventId}/cover/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Dish photos (claimant can upload, anyone can read)
    match /events/{eventId}/dishes/{itemId}/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Menu item photos (creator can upload, anyone can read)
    match /events/{eventId}/menuItems/{itemId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User avatars (user can upload, anyone can read)
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
