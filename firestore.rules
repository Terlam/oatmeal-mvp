rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Events collection
    match /events/{eventId} {
      // Anyone can read public events, authenticated users can read any event
      allow read: if request.auth != null || resource.data.isPublic == true;
      // Only the host can create/update/delete events
      allow create: if request.auth != null && request.auth.uid == request.resource.data.hostId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.hostId;
      
      // Menu items subcollection
      match /menuItems/{itemId} {
        // Anyone authenticated can read
        allow read: if request.auth != null;
        // Any authenticated user can create menu items
        allow create: if request.auth != null;
        // Any authenticated user can update/delete menu items
        allow update, delete: if request.auth != null;
      }
      
      // RSVPs subcollection - using userId as document ID for efficient rule checking
      match /rsvps/{userId} {
        // Anyone authenticated can read
        allow read: if request.auth != null;
        // Users can create their own RSVP
        // Document ID must be their userId, and data must have matching userId and eventId
        allow create: if request.auth != null && 
          request.auth.uid == userId && 
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.eventId == eventId;
        // Users can update their own RSVP
        // userId and eventId must remain unchanged (if present in update)
        allow update: if request.auth != null && 
          request.auth.uid == userId &&
          // Ensure userId and eventId don't change (if they're in the update)
          (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId) &&
          (!('eventId' in request.resource.data) || request.resource.data.eventId == resource.data.eventId);
        // Host can delete any RSVP, users can delete their own
        allow delete: if request.auth != null && 
          (request.auth.uid == userId ||
           request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.hostId);
      }
      
      // Comments subcollection
      match /comments/{commentId} {
        // Anyone authenticated can read
        allow read: if request.auth != null;
        // Any authenticated user can create comments
        allow create: if request.auth != null;
        // Users can update/delete their own comments
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }
    
    // Users collection (if you have one)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

